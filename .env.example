# FastAPI / CORS
STEGOCRYPT_VERSION=1.0.0
STEGOCRYPT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# TCP transfer listener
STEGOCRYPT_TCP_HOST=127.0.0.1
STEGOCRYPT_TCP_PORT=8765

# Optional Ed25519 identity configuration.
# Leave unset for an ephemeral identity during local development.
# STEGOCRYPT_IDENTITY_PRIVATE_KEY_PATH=backend/runtime/identity.pem
# STEGOCRYPT_TRUSTED_PEER_KEYS=<urlsafe-base64-ed25519-public-key>

# Resource limits
STEGOCRYPT_MAX_MESSAGE_BYTES=262144
STEGOCRYPT_MAX_COVER_IMAGE_BYTES=10485760
STEGOCRYPT_MAX_STEGO_IMAGE_BYTES=20971520
STEGOCRYPT_MAX_FRAME_BYTES=20971520
STEGOCRYPT_TCP_CHUNK_SIZE=65536
STEGOCRYPT_SESSION_LIFETIME_SECONDS=1800
STEGOCRYPT_JOIN_CODE_LIFETIME_SECONDS=600
STEGOCRYPT_QIM_DELTA=8
STEGOCRYPT_MAX_IMAGE_WIDTH=4096
STEGOCRYPT_MAX_IMAGE_HEIGHT=4096

# Timeouts
STEGOCRYPT_CONNECT_TIMEOUT=5
STEGOCRYPT_HANDSHAKE_TIMEOUT=5
STEGOCRYPT_FRAME_TIMEOUT=10
STEGOCRYPT_TRANSFER_TIMEOUT=120
